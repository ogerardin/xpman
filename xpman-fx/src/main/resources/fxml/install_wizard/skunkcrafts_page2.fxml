<?xml version="1.0" encoding="UTF-8"?>

<?import com.ogerardin.xpman.util.jfx.wizard.ValidatingWizardPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ValidatingWizardPane prefHeight="200.0" prefWidth="500.0" 
                      xmlns="http://javafx.com/javafx/8.0.171" 
                      xmlns:fx="http://javafx.com/fxml/1" 
                      fx:controller="com.ogerardin.xpman.install.wizard.SkunkcraftsPage2Controller">
    <headerText>Updating...</headerText>
    <content>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label fx:id="fileLabel" text="Preparing update..."/>
            <ProgressBar fx:id="progress" maxWidth="Infinity" minHeight="20" prefHeight="20" progress="0.0"/>
        </VBox>
    </content>
</ValidatingWizardPane>
