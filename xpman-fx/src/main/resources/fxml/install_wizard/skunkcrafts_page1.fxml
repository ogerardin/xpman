<?xml version="1.0" encoding="UTF-8"?>

<?import com.ogerardin.xpman.util.jfx.wizard.ValidatingWizardPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ValidatingWizardPane prefHeight="300.0" prefWidth="500.0"
                      xmlns="http://javafx.com/javafx/8.0.171"
                      xmlns:fx="http://javafx.com/fxml/1"
                      fx:controller="com.ogerardin.xpman.install.wizard.SkunkcraftsPage1Controller">
    <headerText>Review update information</headerText>
    <content>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0" minHeight="0.0">
            <content>
                <VBox spacing="15.0">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                    </padding>
                    <Label fx:id="addonNameLabel" wrapText="true" maxWidth="Infinity"
                           style="-fx-font-size: 1.2em; -fx-font-weight: bold;"/>
                    <GridPane hgap="20.0" vgap="12.0" minWidth="0.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                        </columnConstraints>
                        <Label text="Installed" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               GridPane.valignment="TOP"/>
                        <Label fx:id="currentVersionLabel" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Channel" GridPane.rowIndex="1" GridPane.columnIndex="0"
                               GridPane.valignment="TOP"/>
                        <VBox spacing="0.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label fx:id="selectedChannelLabel"/>
                            <HBox fx:id="channelChoices" spacing="15.0">
                                <RadioButton fx:id="stableRadio" text="Stable">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="channelToggle"/>
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="betaRadio" text="Beta" toggleGroup="$channelToggle"/>
                            </HBox>
                        </VBox>
                        <Label text="Available" GridPane.rowIndex="2" GridPane.columnIndex="0"
                               GridPane.valignment="TOP"/>
                        <Label fx:id="remoteVersionLabel" wrapText="true" maxWidth="Infinity"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Separator/>
                    <Label fx:id="filesCountLabel" wrapText="true" maxWidth="Infinity"/>
                </VBox>
            </content>
        </ScrollPane>
    </content>
</ValidatingWizardPane>
