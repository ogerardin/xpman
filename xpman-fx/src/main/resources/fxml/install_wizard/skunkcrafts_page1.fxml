<?xml version="1.0" encoding="UTF-8"?>

<?import com.ogerardin.xpman.util.jfx.wizard.ValidatingWizardPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ValidatingWizardPane prefHeight="300.0" prefWidth="500.0" 
                      xmlns="http://javafx.com/javafx/8.0.171" 
                      xmlns:fx="http://javafx.com/fxml/1" 
                      fx:controller="com.ogerardin.xpman.install.wizard.SkunkcraftsPage1Controller">
    <headerText>Review update information</headerText>
    <content>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <VBox spacing="5.0">
                <Label text="Addon:" style="-fx-font-weight: bold;"/>
                <Label fx:id="addonNameLabel" text=""/>
            </VBox>
            <VBox spacing="5.0">
                <Label text="Current version:" style="-fx-font-weight: bold;"/>
                <Label fx:id="currentVersionLabel" text=""/>
            </VBox>
            <VBox spacing="5.0">
                <Label text="Available version:" style="-fx-font-weight: bold;"/>
                <Label fx:id="remoteVersionLabel" text=""/>
            </VBox>
            <VBox spacing="5.0">
                <Label text="Update status:" style="-fx-font-weight: bold;"/>
                <Label fx:id="filesCountLabel" text=""/>
            </VBox>
        </VBox>
    </content>
</ValidatingWizardPane>
