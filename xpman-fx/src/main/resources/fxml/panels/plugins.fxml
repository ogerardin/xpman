<?xml version="1.0" encoding="UTF-8"?>


<?import com.ogerardin.xpman.util.jfx.cell_factory.BooleanTreeCellFactory?>
<?import com.ogerardin.xpman.util.jfx.cell_factory.PluginIconTreeCellFactory?>
<?import javafx.scene.control.cell.TreeItemPropertyValueFactory?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/10.0.2-internal"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ogerardin.xpman.panels.plugins.PluginsController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <Button mnemonicParsing="false" onAction="#reload" text="Reload">
                <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#install" text="Install...">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
            </Button>
            <Button fx:id="installScriptButton" mnemonicParsing="false" onAction="#installScript" text="Install Script...">
                <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
            </Button>
        </ToolBar>
    </top>
    <center>
        <TreeTableView fx:id="pluginTable" prefHeight="400.0" prefWidth="600.0" showRoot="false">
      <columns>
          <TreeTableColumn editable="false" prefWidth="48.0" sortable="false">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="system"/>
              </cellValueFactory>
              <cellFactory>
                  <PluginIconTreeCellFactory/>
              </cellFactory>
          </TreeTableColumn>
          <TreeTableColumn prefWidth="80.0" text="Enabled">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="enabled" />
              </cellValueFactory>
              <cellFactory>
                  <BooleanTreeCellFactory/>
              </cellFactory>
          </TreeTableColumn>
          <TreeTableColumn prefWidth="150.0" text="Name">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="name" />
              </cellValueFactory>
          </TreeTableColumn>
          <TreeTableColumn prefWidth="300.0" text="Description">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="desc" />
              </cellValueFactory>
          </TreeTableColumn>
          <TreeTableColumn prefWidth="150.0" text="Version">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="version" />
              </cellValueFactory>
          </TreeTableColumn>
          <TreeTableColumn prefWidth="150.0" text="Latest version">
              <cellValueFactory>
                  <TreeItemPropertyValueFactory property="latestVersion" />
              </cellValueFactory>
          </TreeTableColumn>
      </columns>
    </TreeTableView>
    </center>
</BorderPane>
